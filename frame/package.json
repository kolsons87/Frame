{
  "name": "frame",
  "private": true,
  "description": "Frame — movie/TV tracker. Prototype, ranking engine, and backend schema.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "npm run test:ranking && npm run test:db",
    "test:ranking": "node --test \"packages/ranking/test/**/*.test.ts\"",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "test:prototype": "node prototype/tests/regression.mjs prototype",
    "preview": "python3 -m http.server 8000 --bind 127.0.0.1 --directory prototype"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "playwright": "1.47.2"
  }
}
